# ==============================================================================
# SIH26047 — PATIENT CASE-TAKING SOFTWARE
# Environment Configuration Template
# NOTE: Do NOT place real secrets in this template or commit actual .env files!
# ==============================================================================

# Application Operational Mode (DEMO | MOCK | PRODUCTION)
NEXT_PUBLIC_APP_MODE=DEMO
NEXT_PUBLIC_APP_NAME="SIH26047 Clinical Case-Taking Intelligence"
NEXT_PUBLIC_FACILITY_NAME="AIIMS OPD First-Mile Kiosk"

# Clinical AI Gateway Configuration
# Supported AI_PROVIDER values: mock | gemini | openai | anthropic
AI_PROVIDER=mock
AI_MODEL_ID=mock-clinical-synthesizer-v1
AI_GATEWAY_TIMEOUT_MS=8000

# Speech & Voice Service Configuration
# Supported SPEECH_PROVIDER values: browser | mock | bhashini | cloud
SPEECH_PROVIDER=browser
TTS_PROVIDER=browser
TRANSLATION_PROVIDER=mock
VOICE_RETENTION_HOURS=24

# Document AI & OCR Configuration
# Supported OCR_PROVIDER values: mock | tesseract | vision_cloud
OCR_PROVIDER=mock

# Clinical Safety & Rules Configuration
CLINICAL_RULES_MODE=deterministic
TRIAGE_AUTO_ESCALATE=true

# Interoperability & Standards Configuration
FHIR_EXPORT_VERSION=R4
ABDM_BRIDGE_ENABLED=false
ABDM_SANDBOX_ENDPOINT=https://sandbox.abdm.gov.in

# Supabase Architecture (Prepared Boundary - Keep empty for local Demo/Mock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
